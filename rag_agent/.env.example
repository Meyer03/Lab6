# Copia este archivo como .env (en esta misma carpeta) y pon tu llave.
# La misma llave de Anthropic que usa auditoria-juntas.
ANTHROPIC_API_KEY=
# Modelo del agente (formato LiteLLM: proveedor/modelo)
AGENT_MODEL=anthropic/claude-sonnet-5-5
# Fragmentos por búsqueda si el modelo no pide otro número (1 a 10). Lab: iteración A = 10.
K_BUSQUEDA=6
